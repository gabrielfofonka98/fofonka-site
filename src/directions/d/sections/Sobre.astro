---
import { sobre } from '../../../content/copy';
import { splitOn } from '../lib';

const [lead, ...rest] = sobre.paragraphs;
const paragraphs = rest.map((p) => splitOn(p, sobre.highlight));
---

<section class="section wrap sobre" id="sobre" aria-labelledby="sobre-title">
  <div class="sobre__side" data-reveal>
    <p class="prompt">gabriel@fofonka:~$ <b>less sobre.md</b></p>
    <h2 class="section__title display" id="sobre-title">{sobre.eyebrow}</h2>
    <span class="rule" aria-hidden="true"></span>
    <svg class="sobre__link" viewBox="0 0 220 140" aria-hidden="true" focusable="false">
      <path class="draw" d="M 8 8 C 70 20, 150 40, 206 128" pathLength="1" style="--dd:450ms; --dur:1100ms" />
      <circle cx="8" cy="8" r="3.5" />
      <circle cx="206" cy="128" r="3.5" />
    </svg>
  </div>
  <article class="panel pane" data-reveal style="--d:120ms">
    <header class="pane__bar"><span class="tag">sobre.md</span><span class="pane__meta mono" aria-hidden="true">{`${sobre.paragraphs.length} parágrafos`}</span></header>
    <div class="pane__body">
      <p class="pane__lead">{lead}</p>
      {paragraphs.map(([before, focus, after]) => <p>{before}{focus && <mark class="ph">{focus}</mark>}{after}</p>)}
    </div>
    <p class="pane__end mono" aria-hidden="true">(END)</p>
  </article>
</section>

<style>
  .sobre { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  .sobre__side { position: sticky; top: 40px; }
  .sobre__link { display: block; width: calc(100% + clamp(24px, 4vw, 64px)); max-width: 280px; height: auto; margin-top: 110px; overflow: visible; }
  .sobre__link path { fill: none; stroke: var(--gold); stroke-opacity: 0.75; stroke-width: 1.4; }
  .sobre__link circle { fill: var(--gold-hi); }
  .pane { max-width: 70ch; }
  .pane__bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 18px; border-bottom: 1px solid var(--line); }
  .pane__meta { font-size: 12.5px; color: var(--muted); }
  .pane__body { display: grid; gap: 20px; padding: clamp(26px, 4vw, 52px); font-size: clamp(17px, 1.25vw, 19px); color: var(--text-dim); }
  .pane__lead { font-size: clamp(20px, 1.7vw, 24px); color: var(--text); line-height: 1.5; font-weight: 500; letter-spacing: -0.01em; }
  .pane__end { padding: 0 clamp(26px, 4vw, 52px) 22px; font-size: 13px; color: var(--muted); }
  @media (max-width: 900px) {
    .sobre { grid-template-columns: minmax(0, 1fr); }
    .sobre__side { position: static; }
    .sobre__link { display: none; }
  }
</style>

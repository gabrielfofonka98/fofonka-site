---
import {
  siBitwarden,
  siChatwoot,
  siClaude,
  siClickup,
  siCloudflare,
  siGithub,
  siGrafana,
  siN8n,
  siNextdotjs,
  siNotion,
  siResend,
  siSupabase,
  siVercel,
  type SimpleIcon,
} from 'simple-icons';
import { platforms } from '../../../content/platforms';
import { splitOn } from '../lib';

const ICONS: Record<string, SimpleIcon> = {
  'Claude Code': siClaude,
  Supabase: siSupabase,
  Vercel: siVercel,
  Cloudflare: siCloudflare,
  'Next.js': siNextdotjs,
  GitHub: siGithub,
  ClickUp: siClickup,
  n8n: siN8n,
  Notion: siNotion,
  Resend: siResend,
  Grafana: siGrafana,
  Chatwoot: siChatwoot,
  Bitwarden: siBitwarden,
};
// Tools without a simple-icons mark (Codex, Slack, Hotmart, GoHighLevel) get a monogram.

const [before, focus, after] = splitOn(platforms.heading, platforms.highlight);
---

<section class="section wrap tools" id="ferramentas" aria-labelledby="tools-title">
  <header class="tools__head" data-reveal>
    <p class="prompt">gabriel@fofonka:~$ <b>cortex tools --installed</b></p>
    <h2 class="section__title display" id="tools-title">{platforms.eyebrow}</h2>
    <span class="rule" aria-hidden="true"></span>
    <p class="section__lead">{before}<mark class="ph">{focus}</mark>{after}</p>
  </header>
  <div class="panel specimen" data-reveal>
    <header class="specimen__bar mono" aria-hidden="true"><span class="tag">~/tools</span><span>{platforms.items.length} instaladas</span></header>
    <ul class="specimen__grid">
      {platforms.items.map((name, i) => {
        const icon = ICONS[name];
        return (
          <li class="specimen__item" style={`--i:${i}`}>
            <span class="specimen__mark" aria-hidden="true">
              {icon ? <svg viewBox="0 0 24 24" focusable="false"><path d={icon.path} /></svg> : <span class="specimen__mono mono">{name.charAt(0)}</span>}
            </span>
            <h3 class="specimen__name display">{name}</h3>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .tools__head { max-width: 760px; }
  .specimen { margin-top: clamp(40px, 6vw, 72px); }
  .specimen__bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 18px; border-bottom: 1px solid var(--line); font-size: 12.5px; color: var(--muted); }
  .specimen__grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .specimen__item { display: grid; align-content: start; gap: 8px; padding: 24px 20px 26px; border-right: 1px dashed var(--line); border-bottom: 1px dashed var(--line); }
  .specimen__item:nth-child(6n) { border-right: 0; }
  .specimen__item:nth-last-child(-n + 6) { border-bottom: 0; }
  .specimen__mark {
    display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 8px; border: 1px solid var(--line-strong); border-radius: var(--radius);
    background: rgba(6, 10, 24, 0.6); transition: transform 260ms var(--ease-out), border-color 260ms ease, box-shadow 260ms ease;
  }
  .specimen__mark svg { width: 26px; height: 26px; fill: var(--text); transition: fill 260ms ease; }
  .d-motion .specimen__mark { opacity: 0; transform: scale(0.92); transition: opacity 500ms var(--ease-out) calc(200ms + var(--i) * 60ms), transform 600ms var(--ease-out) calc(200ms + var(--i) * 60ms), border-color 260ms ease, box-shadow 260ms ease; }
  .d-motion .specimen.is-in .specimen__mark { opacity: 1; transform: none; }
  .specimen__mono { font-size: 22px; line-height: 1; color: var(--text); transition: color 260ms ease; }
  .specimen__name { font-size: 18px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }
  @media (hover: hover) and (pointer: fine) {
    .specimen__item:hover .specimen__mark { border-color: var(--gold); box-shadow: 0 0 20px rgba(242, 193, 78, 0.35); }
    .specimen__item:hover .specimen__mark svg { fill: var(--gold-hi); }
    .specimen__item:hover .specimen__mono { color: var(--gold-hi); }
  }
  @media (max-width: 1000px) {
    .specimen__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .specimen__item:nth-child(n) { border-right: 1px dashed var(--line); border-bottom: 1px dashed var(--line); }
    .specimen__item:nth-child(3n) { border-right: 0; }
    .specimen__item:nth-last-child(-n + 3) { border-bottom: 0; }
  }
  @media (max-width: 480px) {
    .specimen__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .specimen__item:nth-child(n) { border-right: 1px dashed var(--line); border-bottom: 1px dashed var(--line); }
    .specimen__item:nth-child(2n) { border-right: 0; }
    .specimen__item:nth-last-child(-n + 2) { border-bottom: 0; }
    .specimen__item { padding: 18px 12px 20px; }
  }
</style>

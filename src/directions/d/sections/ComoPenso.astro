---
import { comoPenso } from '../../../content/copy';
import { splitOn } from '../lib';

const [before, focus, after] = splitOn(comoPenso.heading, comoPenso.highlight);
---

<section class="section wrap penso" id="como-penso" aria-labelledby="penso-title">
  <header class="penso__head" data-reveal>
    <p class="prompt">gabriel@fofonka:~$ <b>cortex principles --list</b></p>
    <h2 class="section__title display" id="penso-title">{comoPenso.eyebrow}</h2>
    <span class="rule" aria-hidden="true"></span>
    <p class="section__lead">{before}<mark class="ph">{focus}</mark>{after}</p>
  </header>
  <ol class="rules">
    {comoPenso.principles.map((p, i) => (
      <li class="panel rule-card" data-reveal style={`--d:${i * 90}ms`}>
        <p class="rule-card__ref mono" aria-hidden="true"><span>{`princípio ${String(i + 1).padStart(2, '0')}`}</span><span class="rule-card__star"></span></p>
        <h3 class="rule-card__title display">{p.title}</h3>
        <p>{p.body}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .penso__head { max-width: 760px; }
  .rules { margin-top: clamp(40px, 6vw, 72px); display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(20px, 2.4vw, 32px); }
  .rule-card {
    grid-column: span 2; padding: 26px 26px 30px; min-height: 250px; font-size: 16.5px; color: var(--text-dim);
    transition: opacity 700ms var(--ease-out) var(--d, 0ms), transform 800ms var(--ease-out) var(--d, 0ms), border-color 260ms ease, box-shadow 260ms ease;
  }
  .rule-card:nth-child(4) { grid-column: 2 / span 2; }
  .rule-card__ref { display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; color: var(--gold); margin-bottom: 18px; }
  .rule-card__star { width: 7px; height: 7px; border-radius: 50%; background: var(--gold-hi); box-shadow: 0 0 10px 2px rgba(242, 193, 78, 0.55); }
  .rule-card__title { font-size: clamp(22px, 1.8vw, 26px); line-height: 1.15; letter-spacing: -0.025em; color: var(--text); margin-bottom: 12px; }
  @media (hover: hover) and (pointer: fine) {
    .rule-card.is-in:hover, .rule-card:hover { transition-delay: 0ms; transform: translateY(-3px); border-color: rgba(242, 193, 78, 0.45); box-shadow: 0 0 30px -8px rgba(242, 193, 78, 0.3), 0 30px 60px -40px rgba(0, 0, 0, 0.9); }
  }
  @media (max-width: 1000px) {
    .rules { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .rule-card, .rule-card:nth-child(4) { grid-column: auto; }
    .rule-card:nth-child(5) { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .rules { grid-template-columns: minmax(0, 1fr); }
    .rule-card { min-height: 0; }
  }
</style>

---
import { projects } from '../../../content/projects';
import { hostOf, splitOn } from '../lib';

const [before, focus, after] = splitOn(projects.heading, projects.highlight);
---

<section class="section wrap projetos" id="projetos" aria-labelledby="projetos-title">
  <header class="projetos__head" data-reveal>
    <p class="prompt">gabriel@fofonka:~$ <b>cortex ps --all</b></p>
    <h2 class="section__title display" id="projetos-title">{projects.eyebrow}</h2>
    <span class="rule" aria-hidden="true"></span>
    <p class="section__lead">{before}<mark class="ph">{focus}</mark>{after}</p>
  </header>
  <ul class="cards">
    {projects.items.map((project, i) => {
      const live = project.live;
      return (
        <li class:list={['panel', 'card', { 'card--feature': i === 0, 'card--live': live }]} data-reveal style={`--d:${(i % 2) * 90}ms`}>
          <article>
            <header class="card__bar mono">
              <span class="card__proc" aria-hidden="true"><span class:list={['card__pulse', { 'card__pulse--live': live }]}></span>{`proc ${String(i + 1).padStart(2, '0')}`}</span>
              <span class:list={['status', { 'status--private': !live }]}>{project.status}</span>
            </header>
            <div class="card__body">
              <h3 class="card__name display">{project.name}</h3>
              <p class="card__context">{project.context}</p>
              <p class="card__diff"><span class="card__label mono">diferencial:</span> {project.diferencial}</p>
              <ul class="card__stack" aria-label={`Stack de ${project.name}`}>
                {project.stack.map((item) => <li class="chip">{item}</li>)}
              </ul>
              {project.href && (
                <a class="link-under card__link" href={project.href} rel="noopener" target="_blank">
                  {hostOf(project.href)} <span aria-hidden="true">↗</span><span class="visually-hidden">(abre em nova aba)</span>
                </a>
              )}
            </div>
          </article>
        </li>
      );
    })}
    <li class="more" data-reveal>
      <ul class="more__list">
        {projects.more.map((item) => (
          <li>
            <h3 class="more__name display">{item.name}</h3>
            <p class="more__body">{item.body}</p>
            {item.href && (
              <a class="link-under more__link" href={item.href} rel="noopener" target="_blank">
                {hostOf(item.href)} <span aria-hidden="true">↗</span><span class="visually-hidden">(abre em nova aba)</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </li>
  </ul>
</section>

<style>
  .projetos__head { max-width: 760px; }
  .cards { margin-top: clamp(48px, 6vw, 80px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 3vw, 36px); align-items: start; }
  .card { transition: opacity 700ms var(--ease-out) var(--d, 0ms), transform 800ms var(--ease-out) var(--d, 0ms), border-color 260ms ease; }
  .card--feature { grid-column: 1 / -1; }
  .card--feature .card__body { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 8px 48px; }
  .card--feature .card__name { grid-column: 1 / -1; font-size: clamp(34px, 3.6vw, 52px); }
  .card__bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 18px; border-bottom: 1px solid var(--line); font-size: 12.5px; color: var(--muted); }
  .card__proc { display: inline-flex; align-items: center; gap: 10px; }
  .card__pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); }
  .card__pulse--live { background: var(--gold-hi); box-shadow: 0 0 10px 2px rgba(242, 193, 78, 0.55); }
  .d-motion .card__pulse--live { animation: pulse 2.4s var(--ease-in-out) infinite; }
  @keyframes pulse { 50% { opacity: 0.45; transform: scale(0.8); } }
  .card__body { padding: 26px clamp(22px, 3vw, 36px) 30px; }
  .card__name { font-size: clamp(26px, 2.3vw, 32px); line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 14px; }
  .card__context { color: var(--text); font-size: 17.5px; line-height: 1.6; }
  .card__diff { margin-top: 12px; color: var(--text-dim); line-height: 1.6; }
  .card__label { font-size: 13.5px; color: var(--gold); }
  .card__stack { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 8px; }
  .card__link { display: inline-block; margin-top: 20px; font-size: 16px; }
  .more { padding: 26px clamp(22px, 3vw, 36px) 30px; border: 1px dashed var(--line); border-radius: var(--radius); }
  .more__list { display: grid; gap: 26px; }
  .more__name { font-size: clamp(22px, 1.9vw, 26px); line-height: 1.15; letter-spacing: -0.03em; }
  .more__body { margin-top: 8px; color: var(--text-dim); line-height: 1.6; }
  .more__link { display: inline-block; margin-top: 10px; font-size: 16px; }
  @media (hover: hover) and (pointer: fine) { .card:hover { border-color: rgba(242, 193, 78, 0.4); } }
  @media (max-width: 900px) {
    .cards { grid-template-columns: minmax(0, 1fr); }
    .card--feature .card__body { display: block; }
  }
</style>

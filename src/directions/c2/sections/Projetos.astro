---
import { projects } from '../../../content/projects';
import { hostOf, splitOn, tilt } from '../lib';

const [before, focus, after] = splitOn(projects.heading, projects.highlight);
---

<section class="section wrap projetos" id="projetos" aria-labelledby="projetos-title">
  <header class="projetos__head" data-reveal>
    <h2 class="section__title display" id="projetos-title">
      {projects.eyebrow}
      <svg class="rough" data-rough="underline" data-color="anno" data-width="2" data-seed="91" data-with-parent aria-hidden="true" focusable="false"></svg>
    </h2>
    <p class="section__lead">{before}<mark class="hl">{focus}</mark>{after}</p>
  </header>
  <ul class="cards">
    {projects.items.map((project, i) => (
      <li class:list={['card', { 'card--feature': i === 0 }]} data-reveal style={`--r:${tilt(i + 1, 0.6)}; --d:${(i % 2) * 90}ms`}>
        <span class="tape card__tape" aria-hidden="true"></span>
        <article>
          <header class="card__head">
            <h3 class="card__name display">{project.name}</h3>
            <span class:list={['stamp', { 'stamp--private': !project.live }]}>{project.status}</span>
          </header>
          <p class="card__context">{project.context}</p>
          <p class="card__diff"><span class="card__label hand">diferencial:</span> {project.diferencial}</p>
          <ul class="card__stack" aria-label={`Stack de ${project.name}`}>
            {project.stack.map((item) => <li class="chip">{item}</li>)}
          </ul>
          {project.href && (
            <a class="link-under card__link" href={project.href} rel="noopener" target="_blank">
              {hostOf(project.href)} <span aria-hidden="true">↗</span><span class="visually-hidden">(abre em nova aba)</span>
            </a>
          )}
        </article>
      </li>
    ))}
    <li class="more" data-reveal>
      <ul class="more__list">
        {projects.more.map((item) => (
          <li>
            <h3 class="more__name display">{item.name}</h3>
            <p class="more__body">{item.body}</p>
            {item.href && (
              <a class="link-under more__link" href={item.href} rel="noopener" target="_blank">
                {hostOf(item.href)} <span aria-hidden="true">↗</span><span class="visually-hidden">(abre em nova aba)</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </li>
  </ul>
</section>

<style>
  .projetos__head { max-width: 760px; }
  .cards { margin-top: clamp(48px, 6vw, 80px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 5vw, 64px) clamp(28px, 4vw, 48px); align-items: start; }
  .card {
    position: relative; padding: 40px clamp(24px, 3vw, 40px) 32px clamp(40px, 4vw, 60px); transform: rotate(var(--r));
    background-color: var(--sheet);
    background-image:
      linear-gradient(90deg, transparent calc(clamp(24px, 2.6vw, 38px) - 1px), var(--anno-soft) calc(clamp(24px, 2.6vw, 38px) - 1px), var(--anno-soft) clamp(24px, 2.6vw, 38px), transparent clamp(24px, 2.6vw, 38px)),
      repeating-linear-gradient(transparent 0 31px, rgba(35, 70, 200, 0.1) 31px 32px);
    background-position: 0 0, 0 12px;
    border: 1px solid var(--rule);
    box-shadow: 0 1px 2px rgba(21, 23, 28, 0.06), 0 18px 36px -24px rgba(21, 23, 28, 0.38);
    border-radius: var(--radius);
  }
  .card--feature { grid-column: 1 / -1; }
  .card--feature article { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 8px 48px; }
  .card--feature .card__head { grid-column: 1 / -1; }
  .card--feature .card__name { font-size: clamp(34px, 3.6vw, 52px); }
  .card__tape { top: -12px; left: 50%; margin-left: -48px; transform: rotate(-1.5deg); }
  .card__head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-bottom: 14px; }
  .card__name { font-size: clamp(26px, 2.3vw, 32px); line-height: 1.1; letter-spacing: -0.03em; }
  .card__context { color: var(--ink); font-size: 17.5px; line-height: 1.6; }
  .card__diff { margin-top: 12px; color: var(--ink-soft); line-height: 1.6; }
  .card__label { font-size: 16px; }
  .card__stack { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 8px; }
  .card__link { display: inline-block; margin-top: 20px; font-size: 16px; }
  .more { padding: 32px clamp(24px, 3vw, 36px); border: 1px dashed var(--rule); border-radius: var(--radius); }
  .more__list { display: grid; gap: 28px; }
  .more__name { font-size: clamp(22px, 1.9vw, 26px); line-height: 1.15; letter-spacing: -0.025em; }
  .more__body { margin-top: 8px; color: var(--ink-soft); line-height: 1.6; }
  .more__link { display: inline-block; margin-top: 10px; font-size: 16px; }
  @media (max-width: 900px) {
    .cards { grid-template-columns: minmax(0, 1fr); }
    .card--feature article { display: block; }
  }
</style>

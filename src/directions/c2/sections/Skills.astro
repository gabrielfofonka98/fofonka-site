---
import { skills } from '../../../content/skills';
import { splitOn } from '../lib';

const [before, focus, after] = splitOn(skills.heading, skills.highlight);
---

<section class="section wrap skills" id="skills" aria-labelledby="skills-title">
  <header class="skills__head" data-reveal>
    <h2 class="section__title display" id="skills-title">
      {skills.eyebrow}
      <svg class="rough" data-rough="underline" data-color="anno" data-width="2" data-seed="61" data-with-parent aria-hidden="true" focusable="false"></svg>
    </h2>
    <p class="section__lead">{before}<mark class="hl">{focus}</mark>{after}</p>
  </header>
  <ul class="groups">
    {skills.groups.map((group, i) => (
      <li class="group" data-reveal style={`--d:${(i % 3) * 90}ms`}>
        <svg class="rough group__bracket" data-rough="bracket" data-color="anno" data-width="1.8" data-seed={70 + i} data-with-parent aria-hidden="true" focusable="false"></svg>
        <h3 class="group__title display">{group.title}</h3>
        <p class="group__body">{group.body}</p>
        <ul class="group__tags" aria-label={`Stack de ${group.title}`}>
          {group.tags.map((tag, t) => <li class:list={['chip', { 'chip--lead': t === 0 }]}>{tag}</li>)}
        </ul>
      </li>
    ))}
  </ul>
</section>

<style>
  .skills__head { max-width: 760px; }
  .groups { margin-top: clamp(48px, 6vw, 88px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(48px, 5vw, 72px) clamp(36px, 6vw, 96px); max-width: 1040px; }
  .group { position: relative; padding: 6px 0 8px 30px; }
  .group:nth-child(even) { margin-top: 40px; }
  .group__bracket { inset: 0 auto 0 0; width: 22px; height: 100%; }
  .group__title { font-size: clamp(24px, 2.1vw, 30px); line-height: 1.15; letter-spacing: -0.03em; }
  .group__body { margin-top: 12px; color: var(--ink-soft); max-width: 36ch; }
  .group__tags { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip--lead { background: var(--hl); border-color: transparent; }
  @media (max-width: 1000px) {
    .groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .group:nth-child(n) { margin-top: 0; }
    .group:nth-child(even) { margin-top: 32px; }
  }
  @media (max-width: 640px) {
    .groups { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .group:nth-child(even) { margin-top: 0; }
  }
</style>

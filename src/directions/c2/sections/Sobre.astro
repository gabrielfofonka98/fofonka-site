---
import { sobre } from '../../../content/copy';
import { splitOn } from '../lib';

const [lead, ...rest] = sobre.paragraphs;
const paragraphs = rest.map((p) => splitOn(p, sobre.highlight));
---

<section class="section wrap sobre" id="sobre" aria-labelledby="sobre-title">
  <div class="sobre__margin">
    <h2 class="section__title display" id="sobre-title" data-reveal>
      {sobre.eyebrow}
      <svg class="rough" data-rough="underline" data-color="anno" data-width="2" data-seed="12" data-with-parent aria-hidden="true" focusable="false"></svg>
    </h2>
    <div class="sobre__arrow" aria-hidden="true">
      <svg class="rough" data-rough="arrow" data-from="0.05,0.1" data-to="0.97,0.85" data-bend="0.14" data-color="anno" data-width="1.8" data-seed="13" aria-hidden="true" focusable="false"></svg>
    </div>
  </div>
  <article class="sheet" data-reveal>
    <span class="tape tape--left" aria-hidden="true"></span>
    <span class="tape tape--right" aria-hidden="true"></span>
    <p class="sheet__lead">{lead}</p>
    {paragraphs.map(([before, focus, after]) => <p>{before}{focus && <mark class="hl hl--wrap">{focus}</mark>}{after}</p>)}
  </article>
</section>

<style>
  .sobre { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  .sobre__margin { position: sticky; top: 40px; display: grid; justify-items: start; gap: 28px; }
  .sobre__arrow { position: relative; width: calc(100% + clamp(24px, 4vw, 64px)); height: 120px; margin-top: 150px; }
  .sheet {
    position: relative; display: grid; gap: 20px; padding: clamp(28px, 4vw, 56px);
    background: var(--sheet); border: 1px solid var(--rule); border-radius: var(--radius);
    box-shadow: 0 1px 2px rgba(21, 23, 28, 0.06), 0 18px 40px -24px rgba(21, 23, 28, 0.35);
    font-size: clamp(17px, 1.25vw, 19px); color: var(--ink-soft); max-width: 70ch;
  }
  .sheet__lead { font-size: clamp(20px, 1.7vw, 24px); color: var(--ink); line-height: 1.5; font-weight: 500; letter-spacing: -0.01em; }
  .tape { top: -13px; }
  .tape--left { left: 32px; transform: rotate(-3deg); }
  .tape--right { right: 40px; transform: rotate(2.5deg); }
  @media (max-width: 900px) {
    .sobre { grid-template-columns: minmax(0, 1fr); }
    .sobre__margin { position: static; }
    .sobre__arrow { display: none; }
    .sheet { transform: none; }
  }
</style>

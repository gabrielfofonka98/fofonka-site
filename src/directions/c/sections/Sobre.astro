---
import { sobre } from '../../../content/copy';
import { splitOn } from '../lib';

const [lead, ...rest] = sobre.paragraphs;
const paragraphs = rest.map((p) => splitOn(p, sobre.highlight));
---

<section class="section wrap sobre" id="sobre" aria-labelledby="sobre-title">
  <div class="sobre__margin">
    <h2 class="section__title marker" id="sobre-title" data-reveal>
      {sobre.eyebrow}
      <svg class="rough" data-rough="underline" data-color="pink" data-width="3" data-seed="12" data-with-parent aria-hidden="true" focusable="false"></svg>
    </h2>
    <div class="sobre__arrow" aria-hidden="true">
      <svg class="rough" data-rough="arrow" data-from="0.05,0.1" data-to="0.97,0.85" data-bend="0.18" data-color="pink" data-width="2.6" data-seed="13" aria-hidden="true" focusable="false"></svg>
    </div>
  </div>
  <article class="sheet" data-reveal style="--r:0.8deg">
    <span class="tape tape--left" aria-hidden="true"></span>
    <span class="tape tape--right" aria-hidden="true"></span>
    <p class="sheet__lead">{lead}</p>
    {paragraphs.map(([before, focus, after]) => <p>{before}{focus && <mark class="hl hl--wrap">{focus}</mark>}{after}</p>)}
  </article>
</section>

<style>
  .sobre { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  .sobre__margin { position: sticky; top: 40px; display: grid; gap: 28px; }
  .sobre__arrow { position: relative; width: calc(100% + clamp(24px, 4vw, 64px)); height: 120px; margin-top: 150px; }
  .sheet {
    position: relative; display: grid; gap: 20px; padding: clamp(28px, 4vw, 56px);
    background: #fffdf8; border: 2px solid var(--ink); border-radius: var(--wobble-soft);
    box-shadow: 8px 10px 0 rgba(22, 23, 27, 0.12); transform: rotate(0.8deg);
    font-size: clamp(17px, 1.25vw, 19px); color: var(--ink-soft); max-width: 70ch;
  }
  .sheet__lead { font-size: clamp(20px, 1.7vw, 24px); color: var(--ink); line-height: 1.5; font-weight: 500; }
  .tape { position: absolute; top: -16px; width: 110px; height: 32px; background: var(--tape); border: 1px solid rgba(22, 23, 27, 0.08); }
  .tape--left { left: 28px; transform: rotate(-6deg); }
  .tape--right { right: 36px; transform: rotate(5deg); background: rgba(255, 111, 174, 0.45); }
  @media (max-width: 900px) {
    .sobre { grid-template-columns: minmax(0, 1fr); }
    .sobre__margin { position: static; }
    .sobre__arrow { display: none; }
    .sheet { transform: none; }
  }
</style>

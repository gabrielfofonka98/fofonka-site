---
import { comoPenso } from '../../../content/copy';
import { splitOn, tilt, tint } from '../lib';

const [before, focus, after] = splitOn(comoPenso.heading, comoPenso.highlight);
---

<section class="section wrap penso" id="como-penso" aria-labelledby="penso-title">
  <header class="penso__head" data-reveal>
    <h2 class="section__title marker" id="penso-title">
      {comoPenso.eyebrow}
      <svg class="rough" data-rough="underline" data-color="teal" data-width="3" data-seed="21" data-with-parent aria-hidden="true" focusable="false"></svg>
    </h2>
    <p class="section__lead">{before}<mark class="hl">{focus}</mark>{after}</p>
  </header>
  <ul class="notes">
    {comoPenso.principles.map((p, i) => (
      <li class={`note note--${tint(i)}`} data-reveal style={`--r:${tilt(i, 2.2)}; --d:${i * 90}ms`}>
        <h3 class="note__title marker">{p.title}</h3>
        <p>{p.body}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .penso__head { max-width: 760px; }
  .notes { margin-top: clamp(40px, 6vw, 72px); display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(22px, 3vw, 40px); }
  .note {
    grid-column: span 2; position: relative; padding: 34px 26px 28px; min-height: 250px;
    border-radius: 2px 2px 18px 2px; transform: rotate(var(--r));
    box-shadow: 0 1px 0 rgba(22, 23, 27, 0.06), 6px 12px 22px -12px rgba(22, 23, 27, 0.35);
    transition: transform 600ms var(--ease-out) var(--d, 0ms), box-shadow 240ms var(--ease-out), opacity 600ms var(--ease-out) var(--d, 0ms);
    font-size: 16.5px; color: #2c2e35;
  }
  .note:nth-child(4) { grid-column: 2 / span 2; }
  .note::before {
    content: ''; position: absolute; top: -13px; left: 50%; width: 92px; height: 26px; margin-left: -46px;
    background: rgba(255, 255, 255, 0.55); border: 1px solid rgba(22, 23, 27, 0.08); transform: rotate(-3deg);
  }
  .note--yellow { background: var(--note-yellow); }
  .note--pink { background: var(--note-pink); }
  .note--teal { background: var(--note-teal); }
  .note__title { font-size: clamp(22px, 1.9vw, 27px); line-height: 1.2; font-weight: 800; color: var(--ink); margin-bottom: 14px; }
  @media (hover: hover) and (pointer: fine) {
    .note.is-in:hover { transition-duration: 240ms; transition-delay: 0ms; transform: rotate(0deg) translateY(-6px); box-shadow: 0 1px 0 rgba(22, 23, 27, 0.06), 10px 20px 30px -14px rgba(22, 23, 27, 0.4); }
  }
  @media (max-width: 1000px) {
    .notes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .note, .note:nth-child(4) { grid-column: auto; }
    .note:nth-child(5) { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .notes { grid-template-columns: minmax(0, 1fr); }
    .note { min-height: 0; }
  }
</style>

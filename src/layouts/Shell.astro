---
// Shared document shell for every direction: meta, favicon, skip link and the
// direction contract comment. Visual styling lives in each direction.
import { meta } from '../content/meta';
import { contato } from '../content/copy';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  themeColor: string;
  contract: string;
}

const { title = meta.title, description = meta.description, noindex = false, themeColor, contract } = Astro.props;
const routePath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(routePath, meta.siteUrl).toString();
const ogImage = new URL('/og-image.png', meta.siteUrl).toString();

const profileLabels = ['LinkedIn', 'Instagram', 'GitHub'];
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${meta.siteUrl}/#person`,
  name: 'Gabriel Fofonka',
  url: `${meta.siteUrl}/`,
  image: ogImage,
  description: meta.description,
  jobTitle: 'Head de Operações',
  worksFor: { '@type': 'Organization', name: 'Academia Lendár[IA]' },
  sameAs: contato.channels.filter((c) => profileLabels.includes(c.label)).map((c) => c.href),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:site_name" content={meta.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <Fragment set:html={`<!--${contract}-->`} />
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
